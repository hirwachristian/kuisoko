DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/kuisoko
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string

# MTN MoMo Developer API (https://momodeveloper.mtn.com) - Collections product.
# Leave unset to disable mobile money checkout; /api/momo/request-to-pay returns 503 until configured.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
# Sandbox only accepts EUR; switch to RWF once you move to a live Rwanda merchant account.
MOMO_CURRENCY=EUR

# Brevo (https://www.brevo.com) - transactional emails (welcome email, order status updates).
# Leave unset to disable email sending; sendEmail() logs a warning and skips instead of failing.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=KuISOKO
