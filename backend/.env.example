DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/kuisoko
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string

# MTN MoMo Developer API (https://momodeveloper.mtn.com) - Collections product.
# Leave unset to disable mobile money checkout; /api/momo/request-to-pay returns 503 until configured.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
# Sandbox only accepts EUR; switch to RWF once you move to a live Rwanda merchant account.
MOMO_CURRENCY=EUR

# Paypack (https://paypack.rw) - mobile money aggregator (MTN + Airtel Money) via docs.paypack.rw.
# Create an application in the Paypack dashboard to get a client_id/client_secret pair.
# Leave unset to disable this checkout option; /api/paypack/cashin returns 503 until configured.
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_BASE_URL=https://payments.paypack.rw/api
# "development" or "production" - must match the mode of the webhook you register in the
# Paypack dashboard (Application > Webhooks) so that webhook actually fires for these requests.
PAYPACK_ENVIRONMENT=development
# Signing secret shown when you register a webhook in the Paypack dashboard. Required to verify
# the `x-paypack-signature` header on POST /api/paypack/webhook - without it, webhook events are
# ignored (rejected with 401) and the integration falls back to polling only.
PAYPACK_WEBHOOK_SECRET=

# Brevo (https://www.brevo.com) - transactional emails (welcome email, order status updates).
# Leave unset to disable email sending; sendEmail() logs a warning and skips instead of failing.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=KuISOKO
